{
  "name": "xslint-vscode",
  "displayName": "xslint",
  "description": "XSL/XSLT linting in your editor, powered by xslint",
  "version": "0.0.0",
  "publisher": "maxonfjvipon",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/xslint/xslint-lsp"
  },
  "homepage": "https://github.com/xslint/xslint-lsp#readme",
  "bugs": {
    "url": "https://github.com/xslint/xslint-lsp/issues"
  },
  "keywords": [
    "xsl",
    "xslt",
    "xpath",
    "linter",
    "lsp"
  ],
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:xsl",
    "onLanguage:xml"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "xsl",
        "extensions": [
          ".xsl",
          ".xslt"
        ],
        "aliases": [
          "XSL",
          "XSLT"
        ]
      }
    ]
  },
  "scripts": {
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.1",
    "xslint-lsp": "^0.0.9"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.2"
  }
}
